{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0 --port 5173 --strictPort",
    "dev:kill": "powershell -Command \"$procIds = @(netstat -ano | Select-String ':5173' | Select-String 'LISTENING' | ForEach-Object { ($_ -split '\\\\s+')[-1] } | Where-Object { $_ -match '^[0-9]+$' } | Select-Object -Unique); foreach ($procId in $procIds) { try { Stop-Process -Id $procId -Force -ErrorAction Stop } catch {} }; exit 0\"",
    "build": "node scripts/verify-env.mjs && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.4",
    "vite": "^8.0.12"
  }
}
